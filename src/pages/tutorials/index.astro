---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostRow from "../../components/PostRow.astro";
import { getTutorials } from "../../lib/taxonomy.ts";

const tutorials = await getTutorials();
---

<BaseLayout
  title="Articles | Vaibhav Tripathi"
  description="All tutorials on mobile engineering, architecture, systems, and programming fundamentals."
>
  <main class="container">
    <section class="browse-head">
      <h1>All articles</h1>
      <p class="lede">{tutorials.length} {tutorials.length === 1 ? "article" : "articles"} — newest first. Use Browse in the menu to filter by topic.</p>
    </section>

    <section class="feed">
      {tutorials.length === 0 ? (
        <p class="empty">First articles are on the way.</p>
      ) : (
        tutorials.map((t, i) => <PostRow tutorial={t} first={i === 0} />)
      )}
    </section>
  </main>
</BaseLayout>
