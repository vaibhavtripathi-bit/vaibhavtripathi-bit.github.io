---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_TITLE, AUTHOR } from "../consts.ts";

const metrics = [
  { value: "15+", label: "Years building mobile platforms" },
  { value: "15M+", label: "Device-scale diagnostics at T-Mobile" },
  { value: "10+", label: "iOS & Android apps shipped" },
  { value: "70%", label: "DoS attacks cut via Play Integrity" },
];

const experience = [
  {
    period: "2024 — Present",
    org: "GlobalLogic, Hitachi Group",
    role: "Staff Engineer, Module Owner · T-Mobile Diagnostics Platform",
    points: [
      "Designed and built three Android SDK modules from scratch for diagnostics across no-coverage zone detection, satellite connectivity tracking, and network throughput measurement.",
      "Resolved ANR crashes, race conditions, and data-integrity issues while refactoring core infrastructure with Hilt dependency injection and coroutine-safe concurrency.",
    ],
  },
  {
    period: "2023 — 2024",
    org: "GlobalLogic, Hitachi Group",
    role: "Solution Architect · Ford Credit Mobile Platform",
    points: [
      "Drove mobile architecture strategy for Ford's financial-services apps across Kotlin, Swift, MVVM, Jetpack Compose, and SwiftUI.",
      "Established technical governance, code-quality standards, architecture reviews, and mentoring for senior engineers.",
    ],
  },
  {
    period: "2022 — 2023",
    org: "GlobalLogic, Hitachi Group",
    role: "Senior Engineer · Michael Kors",
    points: [
      "Delivered end-to-end mobile work across iOS and Android, including platform hardening with Play Integrity API and app attestation.",
    ],
  },
  {
    period: "2020 — 2022",
    org: "Robosoft Technologies, TechnoPro Holdings",
    role: "Technical Architect · Tanishq Jewellery",
    points: [
      "Architected a jewellery e-commerce platform with clean architecture and domain-driven design, supporting 10L+ downloads and a rating increase from 3.5 to 4.5+.",
    ],
  },
  {
    period: "2009 — 2020",
    org: "Robosoft Technologies, TechnoPro Holdings",
    role: "Senior Mobile Engineer and Tech Lead",
    points: [
      "Delivered apps and platform modules for McDonald's India, World of Titan, Zee News, Dainik Bhaskar, ESPN Cricinfo, PayPay, and other brands.",
      "Owned mobile architecture, modularized codebases, introduced performance monitoring, and established CI/CD and testing practices.",
    ],
  },
];

const skills = [
  { k: "Languages", items: ["Swift", "Kotlin", "Java", "Objective-C", "C", "C++"] },
  { k: "Architecture", items: ["Clean Architecture", "MVVM", "MVI", "Domain-Driven Design", "Modular Systems"] },
  { k: "Modern Mobile Stack", items: ["SwiftUI", "Jetpack Compose", "Combine", "Coroutines", "Flow", "RxJava", "Jetpack"] },
  { k: "Engineering Practices", items: ["Jenkins", "Azure", "Bitrise", "Git", "Unit Testing", "Quick", "Kotest", "Profiling"] },
];
---

<BaseLayout
  title={`About | ${SITE_TITLE}`}
  description="Vaibhav Tripathi — Mobile Architect with 15+ years building iOS and Android platforms. Clean architecture, Swift, Kotlin, SwiftUI, and Jetpack Compose."
>
  <main class="container profile">
    <!-- Hero -->
    <section class="profile-hero">
      <div class="avatar" aria-hidden="true">VT</div>
      <div class="profile-id">
        <span class="role-badge"><span class="dot"></span> Mobile Architect · 15+ years</span>
        <h1>{AUTHOR.name}</h1>
        <p class="profile-loc">{AUTHOR.location} · iOS · Android · Platform Architecture</p>
        <p class="profile-lede">
          I build scalable iOS and Android platforms for enterprise, retail, telecom, automotive,
          fintech, media, and commerce — and I write the tutorials on this site.
        </p>
        <div class="profile-actions">
          <a class="pbtn pbtn-primary" href={`mailto:${AUTHOR.email}`}>Email me</a>
          <a class="pbtn" href={AUTHOR.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
          <a class="pbtn" href={AUTHOR.github} target="_blank" rel="noreferrer">GitHub</a>
          <a class="pbtn" href="/assets/Vaibhav_Tripathi_Mobile_Architect.pdf" download>Résumé ↓</a>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="profile-stats">
      {metrics.map((m) => (
        <div class="pstat">
          <strong>{m.value}</strong>
          <span>{m.label}</span>
        </div>
      ))}
    </section>

    <!-- Profile -->
    <section class="profile-section">
      <h2 class="psec-title">Profile</h2>
      <p class="psec-body">
        Experienced in clean architecture, modular systems, MVVM, MVI, domain-driven design,
        reactive programming, CI/CD, performance profiling, and production-quality mobile
        engineering. Strong hands-on background across Swift, Kotlin, Java, Objective-C, C/C++,
        SwiftUI, Jetpack Compose, Combine, Coroutines, Flow, RxJava, and Jetpack components.
      </p>
    </section>

    <!-- Experience -->
    <section class="profile-section">
      <h2 class="psec-title">Experience</h2>
      <div class="timeline">
        {experience.map((e) => (
          <div class="tl-item">
            <div class="tl-period">{e.period}</div>
            <p class="tl-role">{e.role}</p>
            <span class="tl-org">{e.org}</span>
            {e.points.map((p) => <p class="tl-body">{p}</p>)}
          </div>
        ))}
      </div>
    </section>

    <!-- Skills -->
    <section class="profile-section">
      <h2 class="psec-title">Skills</h2>
      <div class="skill-blocks">
        {skills.map((s) => (
          <div class="skill-block">
            <span class="skill-k">{s.k}</span>
            <div class="chips">
              {s.items.map((i) => <span class="chip">{i}</span>)}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Education -->
    <section class="profile-section">
      <h2 class="psec-title">Education</h2>
      <p class="psec-body">
        B.Tech, Computer Science and Engineering<br />
        MMMEC Govt. Engineering College, Gorakhpur, India
      </p>
    </section>

    <!-- Contact CTA -->
    <section class="contact-cta">
      <h2>Let's build something</h2>
      <p>Open to mobile architecture and platform leadership conversations.</p>
      <div class="profile-actions">
        <a class="pbtn pbtn-primary" href={`mailto:${AUTHOR.email}`}>Email me</a>
        <a class="pbtn pbtn-onDark" href={AUTHOR.linkedin} target="_blank" rel="noreferrer">Connect on LinkedIn</a>
      </div>
    </section>
  </main>
</BaseLayout>
