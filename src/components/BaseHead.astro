---
// BaseHead: everything that goes in <head> — meta tags, SEO, social previews,
// favicon, fonts, analytics. Used by every page so SEO is consistent site-wide.
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  AUTHOR,
  CLOUDFLARE_ANALYTICS_TOKEN,
  ADSENSE_CLIENT_ID,
} from "../consts.ts";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedDate?: Date;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = "/assets/portfolio-hero.png",
  type = "website",
  publishedDate,
} = Astro.props;

// Build absolute URLs (required by Open Graph / Twitter / canonical).
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);

// JSON-LD structured data — helps Google show rich results.
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: AUTHOR.name,
  jobTitle: "Mobile Architect",
  email: `mailto:${AUTHOR.email}`,
  url: Astro.site?.toString(),
  sameAs: [AUTHOR.linkedin, AUTHOR.github],
  address: { "@type": "PostalAddress", addressLocality: AUTHOR.location },
};
---

<!-- Core -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="canonical" href={canonicalURL} />
<meta name="generator" content={Astro.generator} />

<!-- Primary meta -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={AUTHOR.name} />

<!-- Favicon (inline SVG monogram — no extra file needed) -->
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/favicon.svg" />

<!-- Open Graph (LinkedIn, Facebook, WhatsApp, Slack previews) -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:site_name" content={SITE_TITLE} />
{publishedDate && (
  <meta property="article:published_time" content={publishedDate.toISOString()} />
)}

<!-- Twitter / X card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageURL} />

<!-- RSS feed discovery -->
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
  rel="stylesheet"
/>

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

<!-- Cloudflare Web Analytics (only renders once you add a token in consts.ts) -->
{CLOUDFLARE_ANALYTICS_TOKEN && (
  <script
    defer
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={`{"token": "${CLOUDFLARE_ANALYTICS_TOKEN}"}`}
  />
)}

<!-- Google AdSense (only renders once you add a publisher ID in consts.ts) -->
{ADSENSE_CLIENT_ID && (
  <script
    async
    src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT_ID}`}
    crossorigin="anonymous"
  />
)}
